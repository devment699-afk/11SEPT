<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="#0F172A">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="☰"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#00F5FF"
                android:background="@drawable/bg_input" />

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="TD"
                android:textStyle="bold|italic"
                android:textSize="16sp"
                android:textColor="#0A0E1A"
                android:background="@drawable/btn_send" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TEAMDARK.AI"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="#F1F5F9" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/dot_online" />

                    <TextView
                        android:id="@+id/statusLine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="OFFLINE • UNLIMITED"
                        android:textSize="11sp"
                        android:textColor="#22C55E" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/agentBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="AGENT: OFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:background="@drawable/bg_input" />

            <TextView
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="✦ NEW"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#00F5FF" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="12dp" />

        <LinearLayout
            android:id="@+id/previewBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/previewImg"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_input" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Photo attached — send ke sath AI ko jayegi"
                android:textSize="12sp"
                android:textColor="#94A3B8" />

            <TextView
                android:id="@+id/btnRemoveImg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="✕"
                android:textSize="16sp"
                android:textColor="#EC4899" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/btnGallery"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="🖼"
                android:textSize="20sp"
                android:background="@drawable/bg_input"
                android:textColor="#F1F5F9" />

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input"
                android:hint="Ask anything… C++ Java Python Lua Mod…"
                android:textColor="#F1F5F9"
                android:textColorHint="#64748B"
                android:padding="13dp"
                android:textSize="15sp"
                android:maxLines="5"
                android:inputType="textMultiLine|textCapSentences" />

            <TextView
                android:id="@+id/btnSend"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="➤"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#0A0E1A"
                android:background="@drawable/btn_send" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:text="POWERED BY DARK DEVEL"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FACC15" />
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0B1120"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu"
        app:itemTextColor="#F1F5F9"
        app:itemIconTint="#00F5FF" />
</androidx.drawerlayout.widget.DrawerLayout>
