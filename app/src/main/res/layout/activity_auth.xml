<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:gravity="center"
            android:text="TD"
            android:textStyle="bold|italic"
            android:textSize="26sp"
            android:textColor="#0A0E1A"
            android:background="@drawable/btn_send" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="TEAMDARK.AI"
            android:textStyle="bold"
            android:textSize="26sp"
            android:textColor="#F1F5F9"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ONLINE AGENT • MANUS-STYLE"
            android:textSize="11sp"
            android:textColor="#10B981"
            android:letterSpacing="0.2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Login karke agent unlock karo"
            android:textSize="14sp"
            android:textColor="#94A3B8" />

        <EditText
            android:id="@+id/aName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="Name (register ke liye)"
            android:textColor="#F1F5F9"
            android:textColorHint="#64748B"
            android:padding="14dp" />

        <EditText
            android:id="@+id/aMail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Gmail"
            android:textColor="#F1F5F9"
            android:textColorHint="#64748B"
            android:padding="14dp"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/aPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Password"
            android:textColor="#F1F5F9"
            android:textColorHint="#64748B"
            android:padding="14dp"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/btnReg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:padding="15dp"
            android:text="REGISTER + ENTER"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#0A0E1A"
            android:background="@drawable/btn_send" />

        <TextView
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:padding="15dp"
            android:text="LOGIN"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#00F5FF"
            android:background="@drawable/bg_input" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="POWERED BY DARK DEVEL"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FACC15"
            android:letterSpacing="0.25" />
    </LinearLayout>
</ScrollView>
